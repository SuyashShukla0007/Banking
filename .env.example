# Backend (Render)
PORT=8080

# Database
# For local H2, you can keep defaults by leaving these blank.
# For PostgreSQL on Render/Neon/Supabase, set full URL and credentials.
DATABASE_URL=jdbc:postgresql://HOST:5432/DB_NAME
DATABASE_USERNAME=YOUR_DB_USER
DATABASE_PASSWORD=YOUR_DB_PASSWORD
DATABASE_DRIVER=org.postgresql.Driver
H2_CONSOLE_ENABLED=false

# JWT
JWT_SECRET=replace-with-a-very-long-random-secret
JWT_EXPIRATION=3600000

# Optional JPA tuning
# JPA_DDL_AUTO=update
