  ],
  "item": [
    {
      "name": "1 - Admin Bootstrap",
      "item": [
        {
          "name": "Create Admin (bootstrap with crafted JWT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bootstrap Admin\",\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/admin/create", "host": ["{{base_url}}"], "path": ["admin","create"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate a self-signed JWT using known secret to allow first admin creation",
                  "const secret = pm.collectionVariables.get('jwt_secret');",
                  "const header = { alg: 'HS256', typ: 'JWT' };",
                  "const payload = { sub: '0', role: 'ADMIN', iat: Math.floor(Date.now()/1000), exp: Math.floor(Date.now()/1000) + 3600 };",
                  "function base64Url(source) {",
                  "  const encodedSource = CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(source));",
                  "  return encodedSource.replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "}",
                  "const encodedHeader = base64Url(JSON.stringify(header));",
                  "const encodedPayload = base64Url(JSON.stringify(payload));",
                  "const token = encodedHeader + '.' + encodedPayload;",
                  "const signature = CryptoJS.HmacSHA256(token, secret);",
                  "const encodedSignature = CryptoJS.enc.Base64.stringify(signature).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "const jwt = token + '.' + encodedSignature;",
                  "pm.collectionVariables.set('admin_token', jwt);",
                  "console.log('Bootstrap JWT set (temporary):', jwt);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 or 201', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                  "try { const r = pm.response.json(); if (r.data && r.data.id) { pm.collectionVariables.set('admin_id', r.data.id.toString()); } } catch(e) { console.log('create admin response parse failed', e); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Admin Login (real token)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/admin/login", "host": ["{{base_url}}"], "path": ["api","auth","admin","login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login returns 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('admin_token', json.token); pm.collectionVariables.set('admin_id', json.id ? json.id.toString() : pm.collectionVariables.get('admin_id')); } else if(json.data && json.data.token) { pm.collectionVariables.set('admin_token', json.data.token); pm.collectionVariables.set('admin_id', json.data.id ? json.data.id.toString() : pm.collectionVariables.get('admin_id')); }",
                  "console.log('admin_token saved');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
