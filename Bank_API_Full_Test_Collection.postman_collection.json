          "event": [{"listen":"test","script":{"exec":["pm.test('User create request accepted', ()=>{pm.expect(pm.response.code).to.be.oneOf([200,201,202]);});","try { const r = pm.response.json(); if (r.data && r.data.approvalId) pm.collectionVariables.set('approval_id', r.data.approvalId.toString()); else if (r.data && r.data.id) pm.collectionVariables.set('user_id', r.data.id.toString()); } catch(e) { console.log(e); }"],"type":"text/javascript"}}]
