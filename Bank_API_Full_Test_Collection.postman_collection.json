          "event": [{"listen":"test","script":{"exec":["pm.test('Approve returned 200', ()=>{pm.expect(pm.response.code).to.be.oneOf([200,201]);});","try{ const r = pm.response.json(); if (r.data && r.data.id) pm.collectionVariables.set('user_id', r.data.id.toString()); }catch(e){console.log(e);}"],"type":"text/javascript"}}]
