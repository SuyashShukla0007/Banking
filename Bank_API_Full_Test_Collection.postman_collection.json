    "version": "1.0.0"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "jwt_secret", "value": "changeit-changeit-changeit-changeit-changeit" },
    { "key": "admin_token", "value": "" },
    { "key": "user_token", "value": "" },
    { "key": "admin_id", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "branch_id", "value": "" },
    { "key": "account_id", "value": "" },
    { "key": "account_id_2", "value": "" },
    { "key": "approval_id", "value": "" },
    { "key": "approval_id_2", "value": "" },
    { "key": "account_approval_id", "value": "" },
    { "key": "account_approval_id_2", "value": "" },
    { "key": "transaction_id", "value": "" },
    { "key": "admin_email", "value": "admin@example.com" },
    { "key": "admin_password", "value": "AdminPass123" },
