          "event": [{"listen":"test","script":{"exec":["pm.test('Pending list fetched', ()=>{pm.expect(pm.response.code).to.be.oneOf([200]);});","try{ const r = pm.response.json(); if (r.data && r.data.length) { if(!pm.collectionVariables.get('approval_id')) pm.collectionVariables.set('approval_id', r.data[0].id ? r.data[0].id.toString() : ''); } }catch(e){console.log(e);}"],"type":"text/javascript"}}]
